// R1:  (b+c)* a (b+c)* a (b+c)* (a (b+c)* a (b+c)*)*
R1: [bc]* 'a' [bc]* 'a' [bc]* ('a' [bc]* 'a' [bc]*)*;

// R2:  (a* b a* c)+ + a+
R2: ('a'* 'b' 'a'* 'c')+ | 'a'+;

// R3: (a+b)*c b b ((a+b)*+(c b b)*)*
R3: [ab]* 'cbb' ('a'|'b'|'cbb')*;

// R4 : (a+b+c)* abc
R4: [abc]* 'abc';


